<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- 登录 Fragment -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.weatherforecast.ui.login.LoginFragment"
        android:label="LoginFragment"
        android:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_wbLoginFragment"
            app:destination="@id/wbLoginFragment"/>
    </fragment>

    <!-- 注册 Fragment -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.weatherforecast.ui.login.RegisterFragment"
        android:label="RegisterFragment"
        android:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/wbLoginFragment"
        android:name="com.example.weatherforecast.ui.login.WbLoginFragment"
        android:label="WbLoginFragment"
        android:layout="@layout/fragment_wb_login">
        <action
            android:id="@+id/action_wbLoginFragment_to_loginFragment"
            app:destination="@+id/loginFragment"/>
        <action
            android:id="@+id/action_wbLoginFragment_to_mapFragment"
            app:destination="@+id/mapFragment"/>
    </fragment>
</navigation>
